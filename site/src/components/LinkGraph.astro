---
/*
 * PLACEHOLDER GEOMETRY.
 *
 * The pages and links below are the real ones from `example-wiki/`, but the
 * positions are hand-placed to read well at this size. The running server lays
 * nodes out from a hash of the slug, so the picture a reader gets from their
 * own wiki is generated by a different rule than this one.
 *
 * This is the file the build-time capture replaces: `GET /api/graph` against
 * example-wiki, written to a fixture, read here instead of the arrays below.
 * Until that exists, the caption on this figure is the only thing keeping the
 * claim honest, so do not let the two drift apart.
 */
interface Props {
  labels?: boolean;
  weight?: number;
}

const { labels = true, weight = 1.2 } = Astro.props;

type Kind = 'page' | 'wanted' | 'orphan';

interface Node {
  slug: string;
  x: number;
  y: number;
  r: number;
  kind: Kind;
  lx: number;
  ly: number;
}

const nodes: Node[] = [
  { slug: 'index', x: 110, y: 196, r: 9, kind: 'page', lx: 110, ly: 219 },
  { slug: 'notes/rhizome', x: 216, y: 106, r: 6, kind: 'page', lx: 246, ly: 99 },
  { slug: 'notes/deleuze', x: 330, y: 58, r: 6, kind: 'page', lx: 356, ly: 47 },
  { slug: 'notes/rust', x: 232, y: 278, r: 6, kind: 'page', lx: 232, ly: 299 },
  { slug: 'notes/rust/async', x: 356, y: 228, r: 7.5, kind: 'page', lx: 356, ly: 211 },
  { slug: 'notes/rust/pinning', x: 452, y: 300, r: 6, kind: 'page', lx: 452, ly: 321 },
  { slug: 'notes/rustlings', x: 186, y: 348, r: 6, kind: 'page', lx: 186, ly: 369 },
  { slug: 'scratch/rust/from-a-talk', x: 378, y: 350, r: 6, kind: 'page', lx: 378, ly: 371 },
  { slug: 'notes/rust/streams', x: 470, y: 146, r: 7, kind: 'wanted', lx: 462, ly: 131 },
  { slug: 'scratch/inbox', x: 70, y: 66, r: 6, kind: 'orphan', lx: 70, ly: 53 },
];

const links: [string, string][] = [
  ['index', 'notes/rhizome'],
  ['notes/rhizome', 'notes/deleuze'],
  ['index', 'notes/rust'],
  ['index', 'notes/rust/async'],
  ['notes/rust', 'notes/rust/async'],
  ['notes/rust/async', 'notes/rust/pinning'],
  ['index', 'notes/rustlings'],
  ['index', 'scratch/rust/from-a-talk'],
  ['notes/rust/async', 'notes/rust/streams'],
];

const at = (slug: string): Node => {
  const node = nodes.find((n) => n.slug === slug);
  if (!node) throw new Error(`link references a node that is not drawn: ${slug}`);
  return node;
};

/* A link into a wanted page is the dashed one, and it is dashed because of
 * what it points at rather than because of anything about the link itself. */
const edges = links.map(([from, to]) => {
  const a = at(from);
  const b = at(to);
  return { a, b, wanted: b.kind === 'wanted' };
});

const solid = edges.filter((e) => !e.wanted);
const dashed = edges.filter((e) => e.wanted);
---

<svg viewBox="0 0 520 380" class="block w-full" role="img" aria-label="The link graph of the example wiki">
  <g stroke="var(--color-edge)" stroke-width={weight}>
    {solid.map((e) => <line x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} />)}
  </g>
  {
    dashed.map((e) => (
      <line
        x1={e.a.x}
        y1={e.a.y}
        x2={e.b.x}
        y2={e.b.y}
        stroke="var(--color-amber-edge)"
        stroke-width={weight}
        stroke-dasharray="4 4"
      />
    ))
  }
  <g fill="var(--color-mint)">
    {nodes.filter((n) => n.kind === 'page').map((n) => <circle cx={n.x} cy={n.y} r={n.r} />)}
  </g>
  {
    nodes.filter((n) => n.kind === 'wanted').map((n) => (
      <circle
        cx={n.x}
        cy={n.y}
        r={n.r}
        fill="none"
        stroke="var(--color-amber)"
        stroke-width={weight + 0.3}
        stroke-dasharray="3 3"
      />
    ))
  }
  {
    nodes.filter((n) => n.kind === 'orphan').map((n) => (
      <circle cx={n.x} cy={n.y} r={n.r} fill="none" stroke="#63737f" stroke-width={weight + 0.3} />
    ))
  }
  {
    labels && (
      <g font-family="var(--font-mono)" font-size="9.5" fill="var(--color-ink-fainter)" text-anchor="middle">
        {nodes.map((n) => (
          <text x={n.lx} y={n.ly} fill={n.kind === 'wanted' ? 'var(--color-amber)' : undefined}>
            {n.slug}
          </text>
        ))}
      </g>
    )
  }
</svg>
