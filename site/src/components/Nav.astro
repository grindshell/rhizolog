---
import Mark from './Mark.astro';

/*
 * Docs points at the README on the mirror, which is genuinely the
 * documentation until `/docs` exists here. Demo and API are absent rather than
 * present-and-dead: a nav entry that 404s is worse than one that is not there
 * yet, and adding them back is a one-line change on the day they land.
 */
import { SOURCE, README } from '../links';

const links = [{ label: 'Docs', href: README }];
---

<nav class="flex items-center justify-between border-b border-line px-5 py-4 sm:px-16 sm:py-[22px]">
  <a href="/" class="flex items-center gap-2.5 text-ink" aria-label="Rhizolog, home">
    <Mark size={22} />
    <span class="font-mono text-base font-semibold tracking-tight">rhizolog</span>
  </a>

  <div class="hidden items-center gap-[30px] font-mono text-meta sm:flex">
    {links.map((l) => <a href={l.href} class="text-ink-faint hover:text-ink">{l.label}</a>)}
    <a href={SOURCE} class="text-mint">Source</a>
  </div>

  <a href={SOURCE} class="font-mono text-meta text-mint sm:hidden">Source</a>
</nav>
