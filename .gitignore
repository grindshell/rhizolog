# Rust
target/

# Node / frontend
node_modules/
dist/

# The development wiki. RHIZOLOG_ROOT defaults to ./wiki, so running the
# backend creates this — scratch content plus a derived SQLite index under
# .rhizolog/. None of it belongs in the repo.
backend/wiki/

# Rhizolog's own state inside any wiki directory, including example-wiki/.
# The index is derived from the markdown beside it and rebuilds on startup.
.rhizolog/

# Editor / OS noise
.DS_Store
*.log
